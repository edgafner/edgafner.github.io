<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE labels SYSTEM "https://resources.jetbrains.com/writerside/1.0/labels-list.dtd">
<!--suppress XmlUnresolvedReference -->
<labels xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/labels.xsd">
    <primary-label id="azd" short-name="AZD" name="AZD" color="green">AZD</primary-label>
    <primary-label id="gbrowser" short-name="GBrowser" name="GBrowser" color="blue">GBrowser</primary-label>
    <primary-label id="codecov" short-name="Codecov" name="Codecov" color="strawberry">Codecov</primary-label>
    <primary-label id="queryflag" short-name="QueryFlag" name="QueryFlag" color="tangerine">QueryFlag</primary-label>
    <primary-label id="jirai" short-name="JirAI" name="JirAI" color="blue">JirAI</primary-label>


    <secondary-label id="wip" name="WIP" color="purple">Work in progress</secondary-label>
    <secondary-label id="beta" name="β" color="tangerine">Beta</secondary-label>

    <secondary-label id="experimental" name="Experimental" color="purple">This is an experimental feature</secondary-label>
    <secondary-label id="azd_version" name="2026.3.6" color="blue">New in AZD 2026.3.6</secondary-label>
    <secondary-label id="gbrowser_version" name="2026.3.1" color="tangerine">New in GBrowser 2026.3.1</secondary-label>
    <secondary-label id="codecov_version" name="2026.3.2" color="green">New in Codecov 2026.3.2</secondary-label>
    <secondary-label id="queryflag_version" name="2026.3.1" color="blue">New in QueryFlag 2026.3.1</secondary-label>
    <secondary-label id="jirai_version" name="2026.3" color="blue">New in JirAI 2026.3</secondary-label>
</labels>
