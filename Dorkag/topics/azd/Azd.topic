            <a href="Azd-Manage-projects-hosted-on-Azure-DevOps.topic" type="folder"
               summary="Clone repositories and open files on Azure DevOps">Clone and manage projects</a>
        </spotlight>

        <primary>
            <title>Work with Azure DevOps</title>
            <a href="Work-with-Azure-DevOps-pull-requests.topic" type="branch"
