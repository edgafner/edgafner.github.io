<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="AZD: Clone and manage projects" id="Azd-Manage-projects-hosted-on-Azure-DevOps">

    <primary-label ref="azd"/>
    <show-structure for="chapter,procedure" depth="2"/>

    <tldr>
        <p>Clone: <ui-path>Git | Clone…</ui-path>, then <control>Azure DevOps</control></p>
        <p>Open a file on the web: <ui-path>Open In | Azure Devops</ui-path> in the context menu</p>
    </tldr>

    <link-summary>Clone Azure DevOps repositories and open files and commits on Azure DevOps from the IDE.</link-summary>
    <card-summary>Clone Azure DevOps repositories and jump from a file to its Azure DevOps web view.</card-summary>
    <web-summary>Clone Azure DevOps repositories in JetBrains IDEs with the AZD plugin, choose SSH or HTTPS, and open
        files, commits and links on Azure DevOps.</web-summary>

    <p>
        AZD adds Azure DevOps to the IDE clone dialog and to the menus that open files and commits in the browser.
    </p>

    <chapter title="Clone a repository" id="checkout">
        <p>
            Clone any <a href="https://learn.microsoft.com/en-us/azure/devops/repos/get-started/what-is-repos">Azure Repos</a>
            Git repository your account can access, and open it as a project.
        </p>
        <p>
            AZD clones over SSH by default, which needs an SSH key registered in Azure DevOps.
            To clone over HTTPS instead, see <a anchor="clone-protocol"/>.
        </p>

        <procedure title="Clone an Azure DevOps repository" id="clone-steps">
            <step>
                <p>Select <ui-path>Git | Clone…</ui-path>, or click <control>Clone Repository</control> on the Welcome screen.</p>
            </step>
            <step>
                <p>In the <control>Clone Repository</control> dialog, select <control>Azure DevOps</control> on the left.</p>
            </step>
            <step>
                <p>If you are not signed in, the dialog shows <control>Log In to AZD</control>.
                    Click <control>Sign in with Microsoft</control> or <control>Sign in with Azure CLI</control>,
                    or click <control>Use token…</control> to enter a personal access token.</p>
                <img src="azd_clone_login.png" alt="Clone Repository dialog with Azure DevOps selected and the Log In to AZD options" width="706" border-effect="rounded" thumbnail="true"/>
                <p>For details about each method, see <a href="Azd-Installation.topic" anchor="connect">Connect to Azure DevOps</a>.</p>
            </step>
            <step>
                <p>Select a repository from the list of all repositories your accounts can access.</p>
                <img src="azd_clone_repositories.png" alt="Clone Repository dialog listing Azure DevOps repositories with the shallow clone option" width="706" thumbnail="true" border-effect="rounded"/>
            </step>
            <step>
                <p>In <control>Directory</control>, enter the folder for the local repository.</p>
            </step>
            <step>
                <p>Optional: select <control>Shallow clone with a history truncated to</control> and enter the number of commits.</p>
            </step>
            <step>
                <p>Click <control>Clone</control>, and confirm that you want to open the cloned sources as a project.</p>
            </step>
        </procedure>
    </chapter>

    <chapter title="Choose SSH or HTTPS" id="clone-protocol">
        <p>
            AZD clones over SSH by default.
            To clone over HTTPS, clear <control>Clone git repositories using ssh</control> in
            <ui-path>Settings | Version Control | AZD</ui-path>.
            With HTTPS, AZD also enables the Git credential helper.
        </p>
        <note>
            With the credential helper enabled, Git asks the credential helper for credentials instead of using your AZD accounts,
            and the <control>Clone Repository</control> dialog shows a warning.
        </note>
    </chapter>

    <chapter title="Open a file on Azure DevOps" id="jump-to">
        <p>
            Open the Azure DevOps web view of a file at the commit you have checked out.
            AZD uses the current revision of the file, so the web view matches your local copy.
        </p>

        <procedure title="Open the current file on Azure DevOps" id="jump-sequence">
            <step>
                <p>Right-click a file in the editor, on an editor tab or in the <control>Project</control> tool window.</p>
            </step>
            <step>
                <p>Select <ui-path>Open In | Azure Devops</ui-path>.</p>
                <!-- planned-image src="azd_open_in_azure_devops.png" alt="Editor context menu with the Open In submenu and Azure Devops highlighted" -->
            </step>
        </procedure>

        <p>
            The file opens in your default browser.
            If the browser is not signed in to Azure DevOps, sign in there.
        </p>

        <procedure title="Open a commit from the annotations" id="open-commit-from-blame">
            <step>
                <p>In the editor, right-click the gutter and select <control>Annotate with Git Blame</control>.</p>
            </step>
            <step>
                <p>Right-click an annotation and select <control>Open on AzureDevops</control>.</p>
            </step>
        </procedure>
    </chapter>

    <chapter title="Copy a link to Azure DevOps" id="copy-link">
        <procedure title="Copy the Azure DevOps URL of a file" id="copy-link-procedure">
            <step>
                <p>Right-click a file in the editor or in the <control>Project</control> tool window, and select <control>Copy Path/Reference…</control>.</p>
            </step>
            <step>
                <p>Select <control>AZD Repository URL</control>.</p>
                <!-- planned-image src="azd_copy_link.png" alt="Copy Path/Reference popup with AZD Repository URL selected" -->
            </step>
        </procedure>
    </chapter>

