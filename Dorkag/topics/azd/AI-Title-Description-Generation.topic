<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="AZD: Generate titles, descriptions and commit messages" id="AI-Title-Description-Generation">

    <primary-label ref="azd"/>
    <show-structure for="chapter,procedure" depth="2"/>

    <tldr>
        <p>Pull requests: the AI buttons in the <control>Title</control> and <control>Description</control> fields of a new pull request</p>
        <p>Commits: <control>Generate Commit Message</control> on the commit message toolbar</p>
        <p>Prompts: <ui-path>Settings | Version Control | AZD | AI Settings</ui-path>, <control>Configure Prompts</control></p>
    </tldr>

    <link-summary>Generate pull request titles and descriptions, update the description of an open pull request and generate commit messages with AI.</link-summary>
    <card-summary>Let AI write pull request titles, descriptions and commit messages from your commits and changes.</card-summary>
    <web-summary>Generate Azure DevOps pull request titles, descriptions and commit messages with AI in JetBrains
        IDEs using AZD, with the built-in provider or your own model.</web-summary>

    <p>
        AZD writes pull request text and commit messages on demand, from your commits and code changes.
        You review and edit the result before you create the pull request or commit.
    </p>

    <chapter title="Before you start" id="ai_gen_provider_options">
        <p>
            The features in this topic work with the built-in AZD provider without any setup.
            To use OpenAI, Claude, Gemini or Ollama instead, see <a href="Azd-AI.topic" anchor="ai-providers"/>.
            For what data AZD sends, see <a href="Azd-AI.topic" anchor="ai-privacy"/>.
        </p>
    </chapter>

    <chapter title="Generate a pull request title and description" id="ai_title_description_generation">
        <procedure title="Generate a title and a description" id="generate-title-description">
            <step>
                Open the new pull request tab; see <a href="Azd-Create-Pull-Request.topic"/>.
            </step>
            <step>
                In the <control>Title</control> field, click the AI button (<control>Generate Title with AI</control>).
                The button shows the icon of the active provider.
                To use another provider, click the arrow next to the button and select it.
                <!-- planned-image src="azd_ai_title_generate.png" alt="New pull request tab with the provider list of the title AI button open" -->
            </step>
            <step>
                In the <control>Description</control> field, click the AI button (<control>Generate Description with AI</control>).
            </step>
            <step>
                Edit the generated text if needed, then create the pull request.
            </step>
        </procedure>
        <p id="how_it_works">
            AZD generates the title and the description from the commit messages and the diff of the pull request.
            With the default prompt, it starts with a short summary, followed by the reasons for the change and a list of changes.
            To stop a generation, click the button again (<control>Stop Generation</control>).
        </p>
    </chapter>

    <chapter title="Update the description of an open pull request" id="update-description">
        <p>
            After you push more commits, let AI update the description of your pull request.
            AI keeps the intent of the existing description and adds the new changes.
            Only the author of the pull request sees this option.
        </p>
        <procedure title="Update the description with AI" id="update-description-procedure">
            <step>
                In the pull request details, click <control>View Timeline</control>.
            </step>
            <step>
                In the timeline header, click <control>Update description using AI</control>.
                <!-- planned-image src="azd_ai_update_description.png" alt="Pull request timeline with the Update description using AI button" -->
            </step>
            <step>
                Check the new description.
                To restore the previous text, click <control>Undo</control> in the <control>Description updated successfully</control> notification within 60 seconds.
            </step>
        </procedure>
    </chapter>

    <chapter title="Generate a commit message" id="commit-message">
        <p id="commit_message_generation">
            In projects with an Azure DevOps remote, the commit message toolbar has an AZD button, <control>Generate Commit Message</control>.
            It generates a message from the changes selected for the commit.
        </p>
        <procedure title="Generate a commit message with AI" id="generate-commit-message">
            <step>
                Open the <control>Commit</control> tool window and select the changes to commit.
            </step>
            <step>
                On the commit message toolbar, click <control>Generate Commit Message</control>.
                To use another provider, click the arrow next to the button and select it.
                <!-- planned-image src="azd_ai_commit_message.png" alt="Commit tool window with a generated message and the AZD provider list open" -->
            </step>
            <step>
                Edit the message if needed, and commit.
            </step>
        </procedure>
        <procedure title="Generate a commit message from a work item" id="generate-commit-message-work-item">
            <step>
                On the commit message toolbar, click the arrow next to <control>Generate Commit Message</control> and select <control>Select Work Item...</control>.
                The <control>Select Work Item for Commit Message</control> dialog opens.
                Later clicks on the button open the dialog again.
            </step>
            <step>
                In the dialog, select the project and one or more work items.
                Clear <control>Only my work items</control> to see all work items.
            </step>
            <step>
                Click <control>Generate Message</control>.
            </step>
        </procedure>
        <p>
            AZD asks AI to write the message from the work items and your changes.
            If AI cannot write one, AZD fills in the commit message template instead.
            The <control>Select Work Item...</control> option and the template are set in the work item settings;
            see <a href="Azd-Boards.topic" anchor="work-item-commit-template"/>.
        </p>
    </chapter>

    <chapter title="Customize the results" id="ai_gen_customization">
        <p>
            Edit the <control>Pull Request title prompt</control>, <control>Pull Request Description Prompt</control> and <control>Commit message prompt</control>
            to change the style, length or language of the results.
            See <a href="Azd-AI.topic" anchor="configure-prompts"/>.
        </p>
    </chapter>

