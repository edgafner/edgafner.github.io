<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="AZD: Boards and work items" id="Azd-Boards">

    <primary-label ref="azd"/>
    <show-structure for="chapter,procedure" depth="2"/>


    <link-summary>Find Azure Boards work items in the AZD Boards tool window, and where to go to edit, create and plan them in the IDE.</link-summary>
    <card-summary>Find, edit and create work items, open a project's summary, board and list, and start a branch from a work item.</card-summary>
    <web-summary>Work with Azure Boards in JetBrains IDEs with AZD: find and edit work items, open a project's Summary, Board and List,
        move Kanban cards, and create branches and commits from work items.</web-summary>

    <p>
        The <control>AZD Boards</control> tool window lists the work items of your Azure DevOps projects.
        It uses the same connection as the pull request and pipeline tool windows, and appears in projects with an Azure DevOps Git remote.
        If you are not connected yet, select the repository and account and click <control>View Work Items</control>.
    </p>

    <deflist type="medium">
        <def title="Find work items">Filter and sort the list in the tool window; see <a anchor="find-work-items"/> below.</def>
        <def title="Open a project">Open a project's <control>Summary</control>, <control>Board</control> and <control>List</control> in an editor tab;
            see <a href="Azd-Boards-Project-Page.topic"/>.</def>
        <def title="Edit a work item">Change fields, plan dates and estimates, hide custom fields and delete work items;
            see <a href="Azd-Work-Item-Details.topic"/>.</def>
        <def title="Timeline, children and attachments">Comment, see child and related work items, linked pull requests and branches, and manage attachments;
            see <a href="Azd-Work-Item-Timeline.topic"/>.</def>
        <def title="Create a work item">Create a work item or a child of one; see <a href="Azd-Create-Work-Item.topic"/>.</def>
        <def title="Branches and commits">Create a branch from a work item, see the current branch's work item in the status bar,
            and reference work items in commits; see <a href="Azd-Work-Item-Branches-Commits.topic"/>.</def>
    </deflist>

    <chapter title="Find work items" id="find-work-items">
        <procedure title="Filter and sort work items" id="filter-work-items">
            <step>
                <p>Open the <control>AZD Boards</control> tool window: <ui-path>View | Tool Windows | AZD Boards</ui-path>.</p>
            </step>
            <step>
                <p>Click the filter icon and select a quick filter: <control>All</control>, <control>Assigned to me</control>
                    or <control>Recent activity</control> (the default).</p>
                <list>
                    <li><control>All</control>: work items of the project that the repository belongs to.</li>
                    <li><control>Assigned to me</control>: work items assigned to you in all projects of the organization or collection.</li>
                    <li><control>Recent activity</control>: work items you recently viewed or changed in all projects of the organization or collection.</li>
                </list>
                <p>The list leaves out work items in the Closed, Done and Removed states.
                    A work item from another project shows the project name as a tag.</p>
                <!-- planned-image src="azd_boards_list.png" alt="AZD Boards tool window listing work items with their type, state, assignee and tags" -->
            </step>
            <step>
                <p>Narrow the list with the search field and the filter chips: <control>Types</control>, <control>States</control>, <control>Created by</control>,
                    <control>Area</control>, <control>Iteration</control>, <control>Assigned to</control> and <control>Tags</control>.
                    <control>Assigned to</control> also offers <control>Unassigned</control>.
                    In each filter popup, <control>All</control> and <control>Clear</control> select or clear every value.</p>
            </step>
            <step>
                <p>To change the order, click the sort icon and select <control>Default (newest first)</control>, <control>Changed Date</control>,
                    <control>ID</control> or <control>Priority</control>.
                    Select <control>Descending</control> to reverse it.</p>
            </step>
        </procedure>
        <p>
            Double-click a work item, or select it and press <shortcut>Enter</shortcut>, to open it.
            Its details open in a tab of the tool window, and its timeline opens in the editor;
            see <a href="Azd-Work-Item-Details.topic"/>.
        </p>
        <p>Right-click a work item for these actions:</p>
        <deflist type="medium">
            <def title="Open Work Item on Azure DevOps">Opens the work item in your browser.</def>
            <def title="Copy Work Item URL">Copies the link to the work item.</def>
            <def title="Create Branch…">Creates a Git branch for the work item; see <a href="Azd-Work-Item-Branches-Commits.topic" anchor="create-branch"/>.</def>
            <def title="Refresh">Reloads the list. The list does not refresh by itself.</def>
            <def title="Delete Work Item…">Moves the work item to the recycle bin; see <a href="Azd-Work-Item-Details.topic" anchor="delete-work-item"/>.</def>
        </deflist>
    </chapter>

