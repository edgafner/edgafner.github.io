<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
    SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="QueryFlag" id="QueryFlag">

  <primary-label ref="queryflag"/>

  <link-summary>Run saved database queries on the text you select in the editor of a JetBrains IDE.</link-summary>
  <card-summary>Run saved database queries on the text you select in the editor.</card-summary>
  <web-summary>QueryFlag runs your saved query templates on the text you select in the editor of JetBrains IDEs that include the Database Tools and SQL plugin.</web-summary>

  <section-starting-page>
    <title>QueryFlag</title>
    <description>
      Save a query once, with a token where the value goes.
      Then select a value in the editor, right-click it, and run the query against your database.
      QueryFlag is a paid plugin with a 30-day free trial and requires the Database Tools and SQL plugin.
    </description>

    <spotlight>
      <a href="QueryFlag-Installation.topic" type="start"
         summary="Check the requirements, install the plugin and start the trial.">Install and activate</a>
      <a href="QueryFlag-Create-Templates.topic" type="learn"
         summary="Save a query with a token for the selected text.">Create query templates</a>
    </spotlight>

    <primary>
      <title>Use QueryFlag</title>
      <a href="Work-with-QueryFlag.topic" type="tools"
         summary="Select a value in the editor and run a template from the context menu.">Run a query on selected text</a>
      <a href="QueryFlag-Create-Templates.topic#create-from-console" type="tools"
         summary="Turn a query in a database console into a template.">Add a template from a console</a>
      <a href="QueryFlag-Create-Templates.topic#token-rules" type="learn"
         summary="Quote the token where the query needs a string value.">Write the template query</a>
      <a href="QueryFlag-Settings.topic" type="settings"
         summary="Manage templates and the console and blank-text options.">Settings</a>
    </primary>

    <secondary>
      <title>Get help</title>
      <a href="QueryFlag-Troubleshooting.topic" type="support"
         summary="Fix a missing menu, validation errors and failing queries.">Troubleshooting</a>
      <a href="QueryFlag-Reference-and-Support.topic" type="support"
         summary="Report a bug, request a feature or contact the developer.">Support</a>
    </secondary>
  </section-starting-page>

</topic>
