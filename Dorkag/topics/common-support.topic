<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="Common support" id="common-support-library" is-library="true">

    <snippet id="support-content">
        <chapter title="Report a bug or request a feature" id="feature_request_and_bug_common">
            <p>
                Bugs and feature requests go to the public
                <a href="https://github.com/edgafner/dorkag/issues">DORKAG issue tracker on GitHub</a>.
                The tracker covers AZD, JirAI, Codecov and QueryFlag.
                GBrowser has its own tracker in the <a href="https://github.com/edgafner/GBrowser/issues">GBrowser repository</a>.
            </p>
            <procedure title="Open an issue on GitHub" id="report_issue_common">
                <step>
                    <p>
                        Open the <a href="https://github.com/edgafner/dorkag/issues/new/choose">new issue page</a>
                        of the DORKAG issue tracker.
                    </p>
                </step>
                <step>
                    <p>
                        Select the bug report or feature request template for your plugin.
                        AZD, Codecov and QueryFlag have their own templates.
                        For any other plugin, open a blank issue.
                    </p>
                </step>
                <step>
                    <p>Name the plugin in the issue title.</p>
                </step>
                <step>
                    <p>Describe the problem or the request, and include:</p>
                    <list>
                        <li>The plugin version, shown in <ui-path>Settings | Plugins | Installed</ui-path>.</li>
                        <li>
                            The IDE name and version, shown in <ui-path>Help | About</ui-path>.
                            On macOS, use the application menu, for example <ui-path>IntelliJ IDEA | About IntelliJ IDEA</ui-path>.
                        </li>
                        <li>The steps that reproduce the problem, and what you expected to happen.</li>
                        <li>
                            Relevant entries from the IDE log, with tokens and other secrets removed.
                            To open the log folder, select <ui-path>Help | Show Log in Finder</ui-path> on macOS
                            or <ui-path>Help | Show Log in Explorer</ui-path> on Windows.
                            On Linux, the menu item names your file manager, for example <ui-path>Help | Show Log in Files</ui-path>.
                        </li>
                    </list>
                </step>
                <step>
                    <p>Submit the issue.</p>
                </step>
            </procedure>
            <p>
                Issues on GitHub are public.
                Remove tokens and other secrets before you submit.
            </p>
        </chapter>

        <chapter title="Contact the developer" id="contact_me_common">
            <p>
                For questions about licensing, or anything you do not want to post publicly, send an email to
                <a href="mailto:jgafner@dorkag.com">jgafner@dorkag.com</a>.
            </p>
        </chapter>
    </snippet>
</topic>
