<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE instance-profile
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/product-profile.dtd">

<instance-profile id="gbrowserlib"
                  name="gbrowserlib"
                  start-page="GBrowser.topic" >


    <snippet id="gbrowsersn.tree">
        <toc-element topic="GBrowser.topic" id="toc_gbrowser_root">
            <toc-element topic="GBrowser-Whats-New.topic" toc-title="What's new" id="toc_gbrowser_whats_new"/>
            <toc-element topic="GBrowser-Installation.topic" id="toc_gbrowser_installation" toc-title="Install"/>
            <toc-element topic="Work-with-GBrowser.topic" id="toc_gbrowser_usage" toc-title="Browse the web"/>
            <toc-element topic="GBrowser-Bookmarks-and-History.topic" id="toc_gbrowser_bookmarks" toc-title="Bookmarks and history"/>
            <toc-element topic="GBrowser-Open-Files-and-Links.topic" id="toc_gbrowser_open_files" toc-title="Open project files and links"/>
            <toc-element topic="GBrowser-DevTools-and-Device-Emulation.topic" id="toc_gbrowser_devtools" toc-title="DevTools and device emulation"/>
            <toc-element topic="GBrowser-Settings-and-Configuration.topic" id="toc_gbrowser_settings" toc-title="Settings reference"/>
            <toc-element topic="GBrowser-Keyboard-Shortcuts.topic" id="toc_gbrowser_shortcuts" toc-title="Keyboard shortcuts"/>
            <toc-element topic="GBrowser-Reference-and-Support.topic" id="toc_gbrowser_support" toc-title="Troubleshooting and support"/>
        </toc-element>
    </snippet>
</instance-profile>
