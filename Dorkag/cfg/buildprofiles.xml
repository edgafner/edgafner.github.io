<?xml version="1.0" encoding="UTF-8"?>
<buildprofiles xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/build-profiles.xsd"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <footer>
        <copyright>2023-2026 DORKAG</copyright>
        <link href="https://github.com/edgafner/dorkag">GitHub</link>
        <social type="twitter" href="https://twitter.com/Jongafner"/>
        <social type="facebook" href="https://www.facebook.com/dorkaag"/>
        <social type="linkedin"
                href="https://www.linkedin.com/in/jonathan-gafner-3415974b/"/>
        <link href="terms-of-service.html">Terms</link>
        <link href="privacy-policy.html">Privacy</link>
    </footer>


    <variables>
        <primary-color>aqua</primary-color>
        <custom-favicons>favicon.png</custom-favicons>
        <header-logo>banner.svg</header-logo>
        <noindex-content>false</noindex-content>
        <offline-docs>false</offline-docs>
        <web-root>https://edgafner.github.io</web-root>
        <product-web-url>https://edgafner.github.io/</product-web-url>
        <og-image>https://edgafner.github.io/images/og_dorkag.png</og-image>
    </variables>

    <sitemap priority="0.35" change-frequency="monthly"/>
    <llms-txt/>

    <build-profile instance="azdlib">
        <variables>
            <header-logo>banner.svg</header-logo>
            <download-page>https://plugins.jetbrains.com/plugin/22319-azd</download-page>
            <download-title>Install AZD</download-title>
            <showDownloadButton>true</showDownloadButton>
            <noindex-content>false</noindex-content>
        </variables>
    </build-profile>
    <build-profile instance="gbrowserlib">
        <variables>
            <download-title>Install GBrowser</download-title>
            <download-page>https://plugins.jetbrains.com/plugin/14458-gbrowser</download-page>
            <showDownloadButton>true</showDownloadButton>
            <noindex-content>false</noindex-content>
        </variables>
    </build-profile>
    <build-profile instance="queryflaglib">
        <variables>
            <download-title>Install QueryFlag</download-title>
            <download-page>https://plugins.jetbrains.com/plugin/18269-queryflag</download-page>
            <showDownloadButton>true</showDownloadButton>
            <noindex-content>false</noindex-content>
        </variables>
    </build-profile>
    <build-profile instance="codecovlib">
        <variables>
            <download-title>Install Codecov</download-title>
            <download-page>https://plugins.jetbrains.com/plugin/23390-codecov</download-page>
            <showDownloadButton>true</showDownloadButton>
            <noindex-content>false</noindex-content>
        </variables>
    </build-profile>
    <build-profile instance="jirailib">
        <variables>
            <download-title>Install JirAI</download-title>
            <download-page>https://plugins.jetbrains.com/plugin/33954-jirai</download-page>
            <showDownloadButton>true</showDownloadButton>
            <noindex-content>false</noindex-content>
        </variables>
    </build-profile>

</buildprofiles>
